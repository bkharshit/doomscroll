<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
        <include domain="database" path="doomscroll.db"/>
        <exclude domain="file" path="datastore/doomscroll_break.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
        <include domain="database" path="doomscroll.db"/>
        <exclude domain="file" path="datastore/doomscroll_break.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
